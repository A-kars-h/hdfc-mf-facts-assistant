# Copy to .env and fill in. NEVER commit .env - it is gitignored.
#   cp .env.example .env
#
# Every value here is a placeholder or empty. There are no real credentials in
# this file, and there must never be any.

# --- Embeddings (source line 20: mandated) -------------------------------
# Do not change without re-indexing. Switching models mid-project changes the
# vector space, invalidates data/chroma, and degrades retrieval to near-noise
# while looking like "RAG just doesn't work".
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chat model (OD-1: pick ONE adapter) ---------------------------------
# openai | anthropic | ollama | none
# `none` runs retrieval + gating with no generation. That is a legitimate
# Phase 3-5 state, and it is the recommended setting until you have decided on
# a provider - retrieval quality can be measured without a chat model at all.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Only for self-hosted or proxy endpoints.
LLM_BASE_URL=

# --- Paths (relative to the project root) --------------------------------
CORPUS_PATH=config/corpus.yaml
RAW_DIR=data/raw
CHROMA_PATH=data/chroma
BM25_PATH=data/bm25.pkl
MANIFEST_PATH=artifacts/manifest.json
EDUCATION_LINKS_PATH=config/education_links.yml

# --- Chunking (architecture-fixed; changing these invalidates the index) --
CHUNK_SIZE=200
CHUNK_OVERLAP=40
# block | label | sentence | auto
CHUNK_SCHEME=auto

# --- Retrieval (architecture §5) -----------------------------------------
TOP_K=5
RRF_K=60
BM25_TOP_N=20
USE_HYBRID=true

# --- THE GATE THRESHOLD --------------------------------------------------
# LEAVE THIS COMMENTED OUT, on purpose.
#
# The key must be ABSENT, not present-and-empty. `SIMILARITY_THRESHOLD=` on its
# own line is a hard `float_parsing` ValidationError in pydantic-settings, not an
# unset value - an empty string is a value, and this field is typed `float |
# None`. So the template below stays commented; uncommenting it and leaving
# nothing after the `=` will stop every entrypoint in the project at config load.
#
# `require_similarity_threshold()` raises NotCalibratedError while no threshold
# is configured, which is correct behaviour. Cosine-similarity ranges depend on
# both the embedding model and the corpus, so any value written down before
# calibration would be an invented number. A wrong threshold is the most
# invisible failure in this project: nothing crashes, the app just starts
# refusing questions the corpus answers perfectly, or answering questions the
# corpus cannot support.
#
# Preferred: do not set it at all. `require_similarity_threshold()` falls back to
# artifacts/calibration.json when this is unset, so the threshold stays the one
# the calibration process derived rather than a copy that can drift. Produce or
# refresh that file with:
#   python -m src.ragbot.eval.calibrate
# To pin the value in .env instead, uncomment and paste that file's
# `similarity_threshold` - never a number typed from memory.
#SIMILARITY_THRESHOLD=

# --- Generation / validation ---------------------------------------------
MAX_ANSWER_SENTENCES=3
MAX_EVIDENCE_CHARS=6000

# --- Retrieval hygiene ---------------------------------------------------
# Every chunk that is mostly return/NAV figures is TAGGED `return_heavy` at
# ingest. Phase 3 deprioritises tagged chunks at retrieval, which is the
# mechanism that keeps "3Y annualised +14.2%" from outranking the exit-load
# fact a user actually asked for.
#
# Setting this true additionally DROPS those chunks from the index. Left false
# on purpose: dropping deletes real page content irreversibly, and it is not
# needed for correctness, because the output screen (FR-20) is the real control.
# Flip it only to A/B the retrieval effect.
DROP_RETURN_ONLY_CHUNKS=false

# --- Ingestion ----------------------------------------------------------
MIN_EXTRACT_CHARS=1500
MAX_RETRIES=2

# --- Safety -------------------------------------------------------------
# Must be true for the deliverable. `dry_run_pii` reports detected PII types
# without blocking, and is for testing the detector only - never for a demo.
BLOCK_PII=true
DRY_RUN_PII=false
